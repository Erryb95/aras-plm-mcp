# Copy to .env and adapt. The server reads these from the environment.

ARAS_URL=http://localhost/InnovatorServer
ARAS_DATABASE=InnovatorSolutions
ARAS_USER=admin
ARAS_PASSWORD=
ARAS_CLIENT_ID=IOMApp

# Read-only by default: writes to a PLM are versioned and audited,
# so they are enabled on purpose.
ARAS_READONLY=true

ARAS_TIMEOUT_MS=120000
